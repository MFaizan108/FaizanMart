# Copy this file to .env and fill in real values for local development.

SECRET_KEY=change-me
DEBUG=True
DJANGO_SETTINGS_MODULE=FaizanMart.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
# NOTE: these point at "localhost" for running manage.py directly from the venv.
# Host ports are remapped (5433/6380) in case this machine already has a native
# Postgres/Redis using the default ports. docker-compose.yml overrides these
# vars to db:5432/redis:6379 for the web & celery containers.
DATABASE_URL=postgres://faizanmart:faizanmart@localhost:5433/faizanmart
POSTGRES_DB=faizanmart
POSTGRES_USER=faizanmart
POSTGRES_PASSWORD=faizanmart

# Redis / Celery
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0

# Elasticsearch (docker-compose exposes it on localhost:9200; adjust if running it elsewhere)
ELASTICSEARCH_URL=http://localhost:9200

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary (leave blank to use local filesystem storage)
CLOUDINARY_URL=

# Email (SMTP) — used for verification / password reset emails
EMAIL_HOST_NAME=FaizanMart
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Google OAuth (leave blank until you create credentials in Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=

# Stripe (leave blank until you create a Stripe account; use test-mode keys for development)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# JazzCash (from your merchant dashboard's Integration Guide; use sandbox credentials first)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:8000/api/payments/callbacks/jazzcash/
JAZZCASH_ENVIRONMENT=sandbox

# EasyPaisa (from your merchant dashboard; use sandbox credentials first)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=http://localhost:8000/api/payments/callbacks/easypaisa/
EASYPAISA_ENVIRONMENT=sandbox

# AI shopping assistant (Ollama, local + free — run `ollama serve` and `ollama pull qwen2.5:7b`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
