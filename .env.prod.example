# Copy to .env on the production host and fill in real values. Never commit the
# filled-in file — it holds live secrets. See deploy/nginx.conf and deploy/backup_db.sh
# for the rest of the production stack this pairs with.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False
DJANGO_SETTINGS_MODULE=FaizanMart.settings.prod
ALLOWED_HOSTS=faizanmart.site,www.faizanmart.site
# SECURE_SSL_REDIRECT defaults to True in prod.py; only set this to False if TLS is
# terminated somewhere Django can't see (shouldn't be needed with the nginx.conf here).
SECURE_SSL_REDIRECT=True

# Postgres — point at the docker-compose `db` service (or a managed Postgres instance)
DATABASE_URL=postgres://faizanmart:CHANGE_ME@db:5432/faizanmart
POSTGRES_DB=faizanmart
POSTGRES_USER=faizanmart
POSTGRES_PASSWORD=CHANGE_ME

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# CORS — the deployed frontend's real origin(s), not localhost
CORS_ALLOWED_ORIGINS=https://faizanmart.site

# Cloudinary — required in production (local filesystem media storage doesn't survive
# container redeploys); get the URL from the Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Email (SMTP) — Gmail requires an App Password, not the account password
EMAIL_HOST_NAME=FaizanMart
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=

# Stripe — LIVE keys (sk_live_/pk_live_), not test-mode
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# JazzCash — production merchant credentials
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=https://faizanmart.site/api/payments/callbacks/jazzcash/
JAZZCASH_ENVIRONMENT=live

# EasyPaisa — production merchant credentials
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=https://faizanmart.site/api/payments/callbacks/easypaisa/
EASYPAISA_ENVIRONMENT=live

# Backup script (deploy/backup_db.sh)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
